{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SchoolConfig",
  "description": "Institution configuration schema for ~/.config/lit-dl/school.json",
  "type": "object",
  "required": [
    "version",
    "school",
    "auth",
    "libraries"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Configuration version for future migrations",
      "const": 1
    },
    "school": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "description": "Full institution name"
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "description": "Institution code or abbreviation"
        },
        "configured_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Configuration timestamp in ISO 8601 format"
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "preset",
            "manual",
            "resource_url",
            null
          ],
          "description": "Configuration source: resource-entry URL, preset, or manual input"
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "type",
        "sso_domain"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cas",
            "sso",
            "custom"
          ],
          "description": "Authentication type"
        },
        "sso_domain": {
          "type": "string",
          "description": "Institution SSO domain, for example login.university.example"
        },
        "carsi_entry": {
          "type": [
            "string",
            "null"
          ],
          "description": "CARSI federation authentication entry URL"
        },
        "carsi_sp_entity_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional CARSI SP EntityID"
        }
      }
    },
    "proxy": {
      "type": "object",
      "properties": {
        "type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ezproxy",
            null
          ],
          "description": "Proxy type"
        },
        "ezproxy_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "EZproxy login URL"
        }
      }
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Subscribed databases accessible with institutional authorization"
    },
    "discovery": {
      "type": "object",
      "properties": {
        "web_of_science_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Web of Science or academic-resource aggregation entry"
        },
        "resource_entry_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "User-supplied library electronic-resource entry"
        },
        "resource_portal_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Resource aggregation portal entry"
        },
        "auth_service_host": {
          "type": [
            "string",
            "null"
          ],
          "description": "Authentication callback service domain"
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "string",
      "default": "",
      "description": "Additional notes"
    },
    "_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Validation warnings that do not block saving"
    }
  },
  "additionalProperties": false
}
